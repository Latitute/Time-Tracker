# ============================================================
# .env — Biến môi trường (KHÔNG commit file này lên git!)
# ============================================================

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=timetracker

# JWT — đổi thành chuỗi ngẫu nhiên, bảo mật
JWT_SECRET=change-this-to-a-random-secret-string

# Server
PORT=3001

# Frontend URL (dùng cho CORS)
FRONTEND_URL=http://localhost:5173
